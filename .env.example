# Copy these into Portainer (Stack > Environment variables), or into a .env file
# next to docker-compose.yml if you run plain `docker compose up -d`.

# --- Required ---------------------------------------------------------------

# Password for the internal Postgres database (any long random string).
DB_PASSWORD=change-me-to-a-long-random-string

# Encrypts stored secrets (SMTP passwords, webhook URLs) and signs logins.
# Any long random string. Do NOT change it after setup, or saved secrets can't be read.
# Generate one with:  openssl rand -hex 32
SECRET_KEY=change-me-to-another-long-random-string

# The address people use to open the app, e.g. https://visitors.company.co.nz
# Used in email links and for the tablets. Must be HTTPS for the iPads to work offline.
APP_URL=http://localhost:8080

# --- Optional ---------------------------------------------------------------

# GitHub account the image is published under (lower case).
GH_OWNER=kiwisin

# Image tag to run. "latest" follows main; pin to a release like "v0.1.0" to control upgrades.
APP_VERSION=latest

# Port on the Docker host. Point your reverse proxy (Nginx Proxy Manager, Traefik, Caddy) at it.
APP_PORT=8080

# Time zone for sign-in times, emails and the nightly backup.
TZ=Pacific/Auckland

# Set to false only if the app is NOT behind a reverse proxy.
TRUST_PROXY=true

# Backups: where to keep them (a named volume, or a host path such as /mnt/nas/visitor-backups),
# what hour to run (0-23) and how many days to keep.
BACKUP_PATH=backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30

# --- Hosting several businesses (optional) ----------------------------------

# Which business opens at the plain addresses (/admin, /kiosk, /rollcall).
# Leave empty to use the first business. Every business also has /b/<web-address>/admin etc.
DEFAULT_BUSINESS=

# Later, with your own domain: give each business its own subdomain, e.g.
#   BASE_DOMAIN=signin.example.com  ->  acme.signin.example.com
# Needs a wildcard DNS record (*.signin.example.com) and a wildcard certificate on your reverse proxy.
# Also set APP_URL=https://signin.example.com
BASE_DOMAIN=
